	measure 'Diferencia entre tipos' = VAR m = CALCULATE([Total contenidos], KEEPFILTERS(catalogo[type] = "Movie")) VAR s = CALCULATE([Total contenidos], KEEPFILTERS(catalogo[type] = "TV Show")) RETURN IF(m > 0 && s > 0, "Diferencia entre tipos: " & FORMAT(ABS(m - s), "#,0") & " títulos", "Un solo tipo visible")
		lineageTag: 6b211772-bc3c-5ec7-a4f9-5b616848edb2

	partition catalogo = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents("C:\Users\LzzZ\Desktop\visualizacion de datos\streamview-analytics-visualizacion-datos\powerbi\data\catalogo.csv"), [Delimiter=",", Columns=13, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"content_id", type text}, {"show_id", type text}, {"type", type text}, {"title", type text}, {"display_title", type text}, {"release_year", Int64.Type}, {"date_added", type date}, {"language", type text}, {"language_label", type text}, {"popularity", type number}, {"popularity_conflict", type logical}, {"vote_average", type number}, {"vote_count", Int64.Type}}, "en-US")
				in
					Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
