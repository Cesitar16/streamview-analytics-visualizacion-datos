# Entorno y artefactos de Python
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Sistema operativo y editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# Datos de origen: se proporcionan localmente y pueden ser voluminosos.
# El directorio y su .gitkeep se conservan versionables.
data/raw/*.csv
powerbi/data/*.csv

# Estado local y cachés de Power BI Desktop (el PBIP/TMDL/PBIR sí se versiona).
**/.pbi/

# Vistas previas temporales de revisión de PDF.
output/pdf/*preview*.png

# Planes y archivos locales de trabajo.
**/superpowers/
tmp/

# Paquete local de datos para adjuntar por la plataforma académica.
output/entrega/
